{
  "name": "kingshot-timing-assistant",
  "private": true,
  "version": "0.3.1",
  "description": "Offline rally coordination and reinforcement timing for Kingshot",
  "author": "Link6",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "prepare:web": "node scripts/prepare-web-assets.cjs",
    "pretest": "node scripts/prepare-web-assets.cjs",
    "predesktop": "node scripts/prepare-web-assets.cjs",
    "predesktop:smoke": "node scripts/prepare-web-assets.cjs",
    "predist:win": "node scripts/prepare-web-assets.cjs",
    "predist:mac": "node scripts/prepare-web-assets.cjs",
    "predist:linux": "node scripts/prepare-web-assets.cjs",
    "start": "node server.cjs",
    "test": "node --test tests/*.test.cjs",
    "desktop": "electron .",
    "desktop:smoke": "electron . --smoke-test",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.link6.kingshot-assistant",
    "productName": "Kingshot Assistant",
    "directories": {
      "output": "desktop-release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "!dist/sw.js"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "electron/icons/icon.ico",
      "uninstallerIcon": "electron/icons/icon.ico",
      "artifactName": "Kingshot-Assistant-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Kingshot-Assistant-Portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/icons/icon.icns",
      "category": "public.app-category.utilities",
      "artifactName": "Kingshot-Assistant-${version}-${arch}.${ext}"
    },
    "dmg": {
      "icon": "electron/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron/icons/icon.png",
      "category": "Utility",
      "artifactName": "Kingshot-Assistant-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Link6",
        "repo": "kingshot-assistant",
        "releaseType": "release"
      }
    ],
    "electronUpdaterCompatibility": ">=2.16"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
