{
  "name": "kingshot-timing-assistant",
  "private": true,
  "version": "0.2.5",
  "description": "Offline rally coordination and reinforcement timing for Kingshot",
  "author": "Link6",
  "engines": { "node": ">=24" },
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.cjs",
    "test": "node --test tests/*.test.cjs",
    "desktop": "electron .",
    "desktop:smoke": "electron . --smoke-test",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "devDependencies": { "electron": "44.7.0", "electron-builder": "26.15.3" },
  "build": {
    "appId": "io.github.link6.kingshot-assistant",
    "productName": "Kingshot Assistant",
    "directories": { "output": "desktop-release" },
    "files": ["dist/**/*", "electron/**/*", "package.json", "!dist/sw.js"],
    "asar": true,
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "Kingshot-Assistant-Setup-${version}-${arch}.${ext}" },
    "portable": { "artifactName": "Kingshot-Assistant-Portable-${version}-${arch}.${ext}" },
    "mac": { "target": "dmg", "category": "public.app-category.utilities" },
    "linux": { "target": "AppImage", "category": "Utility" }
  }
}
